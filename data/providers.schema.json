{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japan-health.example/schemas/providers.schema.json",
  "title": "Japan Health provider access record",
  "description": "Provider access intelligence for discovery and coordination. It does not represent clinical quality, outcomes, or treatment recommendations.",
  "type": "object",
  "required": [
    "id",
    "name",
    "city",
    "area",
    "audience",
    "specialties",
    "doctorEnglish",
    "receptionEnglish",
    "interpreter",
    "coordinator",
    "selfPay",
    "referral",
    "recordStatus",
    "source",
    "verified",
    "notes",
    "expertiseEvidence"
  ],
  "properties": {
    "recordStatus": {
      "type": "string",
      "enum": [
        "demo",
        "official-source-verified"
      ]
    },
    "doctorEnglish": {
      "type": "string",
      "enum": [
        "yes",
        "partial",
        "limited",
        "unknown"
      ]
    },
    "receptionEnglish": {
      "type": "string",
      "enum": [
        "yes",
        "partial",
        "limited",
        "unknown"
      ]
    },
    "interpreter": {
      "type": "string",
      "enum": [
        "yes",
        "available",
        "external",
        "no",
        "unknown"
      ]
    },
    "coordinator": {
      "type": "string",
      "enum": [
        "required",
        "recommended",
        "available",
        "optional",
        "no",
        "varies",
        "unknown"
      ]
    },
    "referral": {
      "type": "string",
      "enum": [
        "required",
        "no",
        "varies",
        "unknown"
      ]
    },
    "priceTransparency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "expertiseEvidence": {
      "type": "array",
      "items": {
        "$ref": "expertise-evidence.schema.json"
      }
    },
    "publishedCosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "amount",
          "sourceUrl",
          "verifiedDate"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "verifiedDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
